{
  "name": "odtumist-bursmetre-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "collect": "node --env-file-if-exists=.env src/collect.js",
    "probe": "node --env-file-if-exists=.env src/probe.js",
    "parse:saved": "node --env-file-if-exists=.env src/parse-saved.js",
    "test": "node --test",
    "browsers:install": "playwright install --with-deps --only-shell chromium"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "linkedom": "0.18.14",
    "playwright": "1.64.1"
  }
}
