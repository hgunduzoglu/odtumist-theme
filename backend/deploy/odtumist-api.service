[Unit]
Description=ODTUMIST Bursmetre read-only JSON API
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/odtumist/app/backend/src/server.js

[Service]
Type=simple
User=bursmetre
Group=bursmetre
WorkingDirectory=/srv/odtumist/app/backend
EnvironmentFile=/etc/odtumist-bursmetre.env
ExecStart=/usr/local/bin/node src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/odtumist-bursmetre
MemoryHigh=128M
MemoryMax=192M
CPUQuota=25%
TasksMax=64

[Install]
WantedBy=multi-user.target
